# OpenAI
OPENAI_API_KEY=sk-...

# Vector Store: "chroma" for local, "pinecone" for production
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# Pinecone (only needed when VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=rag-docs
PINECONE_ENV=us-east-1

# LLM
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
